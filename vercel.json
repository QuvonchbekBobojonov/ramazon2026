{
    "builds": [
        {
            "src": "main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "main.py"
        }
    ],
    "crons": [
        {
            "path": "/api/send-notifications",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/",
            "schedule": "*/5 * * * *"
        }
    ]
}
